# Copy to .env and enter keys locally. Never send keys in chat.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
# Prototype defaults. Override all LLM pricing fields when changing the model.
JEV_MODEL=jev-1.13.0
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=medium
# Set these when changing the LLM model; USD per million tokens.
LLM_INPUT_USD_PER_MILLION=0.20
LLM_CACHED_INPUT_USD_PER_MILLION=0.02
LLM_CACHE_WRITE_USD_PER_MILLION=0.25
LLM_OUTPUT_USD_PER_MILLION=1.20
JEV_INPUT_USD_PER_MILLION=0.042
